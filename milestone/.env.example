# Milestone-5 environment configuration template.
# Copy this file to `.env` and fill in real values locally. NEVER commit the
# real `.env` file -- only this `.env.example` (with placeholder values) is
# committed to version control.

# ---------------------------------------------------------------------------
# Milestone-3/4 engine (unchanged) -- optional, all have safe offline defaults
# ---------------------------------------------------------------------------
# OpenAI key for the LLM-backed Supervisor/Researcher/Writer agents. If unset,
# the engine runs in deterministic offline mode (use_llm=False everywhere).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tavily web-search API key for ResearcherAgent's live web research tool. If
# unset, research falls back to the local data/knowledge_base/*.docx corpus.
TAVILY_API_KEY=

# Redis connection string for persistent episodic/semantic memory. If unset,
# a local SQLite memory store is used instead.
REDIS_URL=

# Set to "true" to enable LLM-backed agents by default (app/core.py).
MILESTONE4_USE_LLM=false
# Python logging level for the structured JSON logger (app/core.py).
MILESTONE4_LOG_LEVEL=INFO

# LangSmith tracing (optional; used by @traceable decorators throughout
# app/core.py and app/governance/*). Leave unset to disable tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=milestone-governance-platform
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# Milestone-5 production layer (new)
# ---------------------------------------------------------------------------
# Required baseline security control: shared-secret key checked against the
# X-API-Key header on every route of app/production_api.py
# (entrypoints/milestone5_production_api.py). There is no default -- if this
# is unset, every request to the production API fails closed with a 500, and
# any request without a matching header fails with 401.
MILESTONE5_API_KEY=change-me-to-a-long-random-string

# Required M6 signing secret used to issue and verify short-lived HS256 bearer
# JWTs. Generate a long random value; protected routes require this token AND
# the API key above.
MILESTONE5_JWT_SECRET=replace-with-a-long-random-jwt-signing-secret
# Duration in minutes for M6 access tokens. Keep this short for the live demo.
MILESTONE6_JWT_EXPIRY_MINUTES=30
# Demo account name accepted by POST /auth/token after API-key verification.
MILESTONE6_DEMO_USERNAME=demo-user
# Demo account password accepted by POST /auth/token. Use a non-placeholder
# value only in the untracked .env file.
MILESTONE6_DEMO_PASSWORD=change-me-demo-password
# Paste the short-lived access_token obtained from POST /auth/token here so
# the Streamlit UI can send Authorization: Bearer <token>.
MILESTONE6_JWT_TOKEN=

# Base URL the Streamlit UI (app/production_ui.py) uses to reach the
# production API. Defaults to http://127.0.0.1:8000 if unset.
MILESTONE5_API_BASE_URL=http://127.0.0.1:8000

# Optional overrides for where the monitoring dashboard (app/production_dashboard.py)
# reads span/feedback JSONL logs from. Defaults to logs/spans.jsonl and
# logs/feedback.jsonl if unset.
MILESTONE5_SPAN_LOG_PATH=logs/spans.jsonl
MILESTONE5_FEEDBACK_LOG_PATH=logs/feedback.jsonl
